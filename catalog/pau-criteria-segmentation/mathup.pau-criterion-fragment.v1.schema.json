{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathup.es/schemas/mathup.pau-criterion-fragment.v1.schema.json",
  "title": "MathUp official PAU criterion fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fragmentId", "criterionDocumentId", "criterionLinkId", "matchClassification", "literal", "literalSha256", "categories", "scope", "provenance"],
  "properties": {
    "schemaVersion": { "const": "mathup.pau-criterion-fragment.v1" },
    "fragmentId": { "type": "string", "pattern": "^pau-criterion-fragment-[0-9a-f]{32}$" },
    "criterionDocumentId": { "type": "string" },
    "criterionLinkId": { "type": "string" },
    "matchClassification": { "enum": ["CRITERIA_MATCH_EXACT", "CRITERIA_MATCH_STRUCTURAL"] },
    "literal": { "type": "string", "minLength": 1 },
    "literalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["OFFICIAL_FINAL_ANSWER", "OFFICIAL_INTERMEDIATE_RESULT", "OFFICIAL_METHOD", "OFFICIAL_SCORING_GUIDANCE", "OFFICIAL_FULL_DEVELOPMENT", "OFFICIAL_PARTIAL_DEVELOPMENT", "CRITERIA_SCOPE_AMBIGUOUS"] }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "exerciseId", "subpartId", "subpartLabel"],
      "properties": {
        "level": { "enum": ["EXERCISE", "SUBPART"] },
        "exerciseId": { "type": "string" },
        "subpartId": { "type": ["string", "null"] },
        "subpartLabel": { "type": ["string", "null"] }
      }
    },
    "mathReviewState": { "enum": ["NOT_REQUIRED", "CRITERIA_MATH_REVIEW_REQUIRED"] },
    "provenance": { "type": "object", "required": ["authority", "documentHash", "localPath", "startOffset", "endOffset"] }
  }
}
