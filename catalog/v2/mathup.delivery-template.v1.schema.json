{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathup.es/contracts/mathup.delivery-template.v1.schema.json",
  "title": "MathUp delivery template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templateId", "exerciseId", "revisionId", "modality", "interactionKind", "eligibility", "answerRef", "distractorSetRef", "evidence", "review"],
  "properties": {
    "schemaVersion": { "const": "mathup.delivery-template.v1" },
    "templateId": { "type": "string", "pattern": "^tpl-[0-9a-f-]{36}$" },
    "exerciseId": { "type": "string", "pattern": "^ex-[0-9a-f-]{36}$" },
    "revisionId": { "type": "string" },
    "modality": { "type": "string" },
    "interactionKind": { "enum": ["open-response", "multiple-choice"] },
    "eligibility": { "type": "object" },
    "answerRef": { "type": ["string", "null"] },
    "distractorSetRef": { "type": ["string", "null"] },
    "materializationPolicy": { "type": ["object", "null"] },
    "evidence": { "type": "object" },
    "review": { "type": "object" }
  }
}
