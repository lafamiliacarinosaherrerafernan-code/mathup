{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathup.es/contracts/mathup.identity-redirect.v1.schema.json",
  "title": "MathUp identity redirect v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "redirectId", "oldCandidateId", "oldExerciseId", "newExerciseIds", "redirectKind", "reason", "algorithmVersion", "evidence", "review"],
  "properties": {
    "schemaVersion": { "const": "mathup.identity-redirect.v1" },
    "redirectId": { "type": "string", "pattern": "^redir-[0-9a-f-]{36}$" },
    "oldCandidateId": { "type": "string" },
    "oldExerciseId": { "type": "string" },
    "newExerciseIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ex-[0-9a-f-]{36}$" }, "uniqueItems": true },
    "redirectKind": { "enum": ["ONE_TO_ONE", "SPLIT", "ALIAS", "REVIEW_REQUIRED"] },
    "reason": { "type": "string" },
    "algorithmVersion": { "type": "string" },
    "evidence": { "type": "object" },
    "review": { "type": "object" }
  }
}
